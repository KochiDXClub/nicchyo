{
  "hooks": {
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "PreToolUse":         [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "PermissionRequest":  [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "Notification":       [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "SubagentStart":      [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "SubagentStop":       [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-office-hook.mjs", "timeout": 3 }] }]
  }
}
