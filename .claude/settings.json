{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/miyuk/nicchyo-platform/.claude/hooks/env-guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/miyuk/nicchyo-platform/.claude/hooks/tsc-check.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/miyuk/nicchyo-platform/.claude/hooks/eslint-check.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/miyuk/nicchyo-platform/.claude/hooks/sql-rls-warn.js\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/miyuk/nicchyo-platform/.claude/hooks/img-tag-warn.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git diff --stat HEAD 2>/dev/null | tail -3 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true,
    "frontend-design@frontend-design": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
